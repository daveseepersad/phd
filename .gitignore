# Literature review runs: downloaded PDFs are licensed to you personally, so the
# binaries stay local while the JSON/Markdown/BibTeX audit trail stays tracked.
results/**/pdfs/

# Word lock files, created while a rendered .docx is open
~$*

# Persistent browser profile (contains institutional session cookies)
.cache/
*.env
.env

__pycache__/
*.py[oc]
.venv/
